{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "predev": "fuser -k 3001/tcp 5176/tcp 2>/dev/null; sleep 1.0; true",
    "dev": "concurrently --kill-others --kill-others-on-fail -n api,agi -c blue,green \"pnpm --filter @workspace/api-server dev\" \"pnpm --filter @workspace/r3-agi dev\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./apps/**\" --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "test:watch": "vitest --workspace vitest.workspace.ts",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage"
  },
  "private": true,
  "devDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.62.2",
    "@tailwindcss/oxide-linux-arm64-gnu": "^4.3.2",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.4",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lightningcss-linux-arm64-gnu": "^1.32.0",
    "prettier": "^3.9.5",
    "simple-git-hooks": "^2.13.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm typecheck && pnpm lint"
  }
}
